{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apostrophe",
  "version": "0.3.0",
  "identifier": "com.gerardofranco.apostrophe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Apostrophe",
        "width": 1100,
        "height": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/pandoc", "binaries/typst"],
    "resources": ["dictionaries/es.aff", "dictionaries/es.dic", "dictionaries/es.license.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Gerardo Franco — GPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Editor de Markdown nativo y libre de distracciones.",
    "longDescription": "Apostrophe para Windows: editor de Markdown nativo, minimalista y libre de distracciones. Vista previa en vivo, temas claro/oscuro/sepia, exportación y corrector ortográfico en español. Port nativo del editor Apostrophe de GNOME.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Documento Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "SpanishInternational", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/cli-path.wxs"],
        "componentRefs": ["ElisionCliPath"]
      }
    }
  }
}
